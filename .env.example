# Copy this file to .env (which is gitignored) and fill in the values.
DB_PASSWORD=
# Password a user gets when an admin resets it; they must change it at next login.
DEFAULT_PASSWORD=
# Optional: creates the first admin at startup if no admin exists yet. Remove ADMIN_PASSWORD afterwards.
# A person's name: one or two first names and a last name, e.g. Ion Popescu
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: the PostgreSQL port. A Docker container from docker-compose.yml listens on 5433
# (so it does not clash with a PostgreSQL installed on this machine); a normal installation uses 5432.
# DB_PORT=5433

# Optional: run the automated tests against a separate database instead of the app's own.
# The docker-compose database creates this one for you.
# TEST_DB_NAME=nord_cluj_voting_platform_test
